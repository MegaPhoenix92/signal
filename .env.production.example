# Signal production preflight template.
# Copy to .env.production locally, fill real values outside git, then run:
#   npm run admin -- launch-gate --env-file ./.env.production --json
#   npm run admin -- provider-launch --env-file ./.env.production --json
#
# Placeholder values only. Never commit a filled .env.production file.
# Do not set SIGNAL_ALLOW_LOCAL_ACTOR in production; it is for loopback dev only.

# Durable state-service and API cutover (#72).
SIGNAL_BACKEND_MODE=external-service
SIGNAL_STATE_SERVICE_BACKEND=postgres
SIGNAL_STATE_SERVICE_URL=https://state.signal.example/state
SIGNAL_STATE_SERVICE_TOKEN=<state-service-token>
# The state service accepts SIGNAL_STATE_SERVICE_DATABASE_URL or DATABASE_URL.
SIGNAL_STATE_SERVICE_DATABASE_URL=postgres://signal:<password>@db.example:5432/signal_state_service
DATABASE_URL=postgres://signal:<password>@db.example:5432/signal

# Production auth, signed sessions, CORS, and tenant isolation (#73/#74).
SIGNAL_REQUIRE_SIGNED_SESSION=true
SIGNAL_SESSION_SECRET=<at-least-32-character-random-session-secret>
SIGNAL_COOKIE_SECURE=true
SIGNAL_WEBHOOK_ACTOR=usr_system_webhook
SIGNAL_OAUTH_ACTOR=usr_system_oauth
SIGNAL_AUTH_PROVIDER=jwks
SIGNAL_AUTH_JWKS_URL=https://idp.example/.well-known/jwks.json
SIGNAL_API_CORS_ORIGINS=https://signal.example
SIGNAL_TENANT_ISOLATION_MODE=rls
SIGNAL_STATE_SERVICE_RLS=true
SIGNAL_API_MAX_BODY_BYTES=1048576
SIGNAL_API_RATE_LIMIT_RPS=40
SIGNAL_API_RATE_LIMIT_BURST=120
SIGNAL_API_UNAUTH_RATE_LIMIT_RPS=10
SIGNAL_API_UNAUTH_RATE_LIMIT_BURST=40
SIGNAL_API_WEBHOOK_RATE_LIMIT_RPS=20
SIGNAL_API_WEBHOOK_RATE_LIMIT_BURST=60

# Managed scheduler and operations alerting.
SIGNAL_JOB_SCHEDULER=signal-scheduler
SIGNAL_PROVIDER_VALIDATION_SCHEDULER=signal-scheduler
SIGNAL_SCHEDULER_LOCK_POLICY=single-runner

# Backup, restore, migration, and launch evidence metadata.
SIGNAL_STATE_BACKUP_SCHEDULE=daily
SIGNAL_STATE_BACKUP_RETENTION_DAYS=30
SIGNAL_STATE_RESTORE_REHEARSAL_AT=<iso-restore-rehearsal-timestamp>
SIGNAL_STATE_MIGRATION_ROLLOUT_PLAN=<change-ticket-or-runbook-url>
SIGNAL_OPERATIONS_RUNBOOK_URL=https://runbooks.example/signal-production
SIGNAL_OPERATIONS_ALERT_CHANNEL=<ops-alert-channel>

# Gmail OAuth and webhook provider config (#75).
SIGNAL_GMAIL_CLIENT_ID=<gmail-client-id>
SIGNAL_GMAIL_CLIENT_SECRET=<gmail-client-secret>
SIGNAL_GMAIL_REDIRECT_URI=https://signal.example/api/oauth/gmail/callback
SIGNAL_GMAIL_PUBSUB_TOPIC=<gmail-pubsub-topic>
SIGNAL_GMAIL_NOTIFICATION_URL=https://signal.example/api/webhooks/gmail
SIGNAL_GMAIL_WEBHOOK_AUDIENCE=https://signal.example/api/webhooks/gmail
SIGNAL_GMAIL_ACCESS_TOKEN=<sandbox-gmail-access-token>
SIGNAL_GMAIL_WEBHOOK_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
SIGNAL_GMAIL_WEBHOOK_JWKS_CACHE_SECONDS=300
SIGNAL_GMAIL_WEBHOOK_JWKS_TIMEOUT_MS=5000

# Microsoft Graph / Outlook OAuth and webhook provider config (#75).
SIGNAL_OUTLOOK_CLIENT_ID=<outlook-client-id>
SIGNAL_OUTLOOK_CLIENT_SECRET=<outlook-client-secret>
SIGNAL_OUTLOOK_TENANT_ID=common
SIGNAL_OUTLOOK_REDIRECT_URI=https://signal.example/api/oauth/outlook/callback
SIGNAL_OUTLOOK_NOTIFICATION_URL=https://signal.example/api/webhooks/outlook
SIGNAL_OUTLOOK_LIFECYCLE_NOTIFICATION_URL=https://signal.example/api/webhooks/outlook/lifecycle
SIGNAL_OUTLOOK_ACCESS_TOKEN=<sandbox-outlook-access-token>
SIGNAL_OUTLOOK_SUBSCRIPTION_RESOURCE=me/messages
SIGNAL_OUTLOOK_WEBHOOK_CLIENT_STATE=<outlook-webhook-client-state>

# OAuth state and encrypted provider-token storage (#75).
SIGNAL_OAUTH_STATE_KEY=<oauth-state-signing-key>
SIGNAL_TOKEN_ENCRYPTION_KEY=<token-vault-encryption-key>
SIGNAL_TOKEN_VAULT=./data/provider-token-vault.json

# Outbound email / SendGrid provider config (#75).
SIGNAL_EMAIL_PROVIDER=sendgrid
SIGNAL_EMAIL_PROVIDER_MODE=live
SIGNAL_EMAIL_PROVIDER_NAME=sendgrid
SIGNAL_EMAIL_PROVIDER_URL=https://api.sendgrid.com/v3/mail/send
SIGNAL_EMAIL_PROVIDER_TOKEN=<email-provider-token>
SIGNAL_EMAIL_FROM=alerts@signal.example
SIGNAL_EMAIL_STATUS_WEBHOOK_SECRET=<email-status-webhook-secret>
SIGNAL_EMAIL_UNSUBSCRIBE_BASE_URL=https://signal.example

SIGNAL_SENDGRID_API_BASE_URL=https://api.sendgrid.com
SIGNAL_SENDGRID_API_KEY=<sendgrid-api-key>
SIGNAL_SENDGRID_EVENT_WEBHOOK_PUBLIC_KEY=<sendgrid-event-webhook-public-key>
SIGNAL_SENDGRID_SANDBOX_MODE=true
SIGNAL_SENDGRID_ASM_GROUP_ID=<asm-group-id>
SIGNAL_SENDGRID_ASM_GROUPS_TO_DISPLAY=<asm-group-id>
SIGNAL_SENDGRID_CATEGORIES=sales_signal,product_ideas
SIGNAL_SENDGRID_CLICK_TRACKING=false
SIGNAL_SENDGRID_OPEN_TRACKING=false
SIGNAL_SENDGRID_IP_POOL_NAME=<sendgrid-ip-pool-name>
SIGNAL_SENDGRID_REPLY_TO=ops@signal.example

# Stripe billing provider config (#75).
STRIPE_SECRET_KEY=<stripe-secret-key>
STRIPE_WEBHOOK_SECRET=<stripe-webhook-secret>
STRIPE_PUBLISHABLE_KEY=<stripe-publishable-key>
SIGNAL_STRIPE_PRICE_TEAM=<stripe-team-price-id>
SIGNAL_STRIPE_PRICE_BETA=<stripe-beta-price-id>
SIGNAL_STRIPE_PRICE_BUSINESS=<stripe-business-price-id>
SIGNAL_APP_BASE_URL=https://signal.example
SIGNAL_STRIPE_SUCCESS_URL=https://signal.example/#workspace?billing=success&session_id={CHECKOUT_SESSION_ID}
SIGNAL_STRIPE_CANCEL_URL=https://signal.example/#workspace?billing=cancel
SIGNAL_STRIPE_PORTAL_RETURN_URL=https://signal.example/#admin?billing=portal_return
